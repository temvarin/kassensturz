@* A banner has no parameters, so it isn't redrawn with its page and listens for changes itself (DataComponent). *@
@inherits DataComponent
@inject BackupService Backup

@if (Backup.IsDue)
{
    <a class="banner" href="einstellungen">
        <Icon Name="cloud-upload" />
        <span>@(Backup.LastBackup is { } last ? $"Letzte Sicherung {German.Relative(last, Today)}" : "Noch keine Sicherung") – jetzt sichern</span>
        <Icon Name="chevron-right" />
    </a>
}
