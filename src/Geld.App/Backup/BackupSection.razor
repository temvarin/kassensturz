@* Settings: backup files, and whether the browser protects the storage. *@
@inherits DataComponent
@inject Browser Browser
@inject Dialogs Dialogs
@inject BackupService Backup

<div class="section"><h2>Sicherung</h2></div>
<div class="card">
    <p class="hint">
        @if (!Backup.IsSynced)
        {
            @:Deine Daten liegen nur in diesem Browser. Wird die App gelöscht oder das Handy gewechselt, sind sie weg –
            @:außer du hast eine Sicherung.
        }
        else
        {
            @:Deine Daten liegen auch auf dem Server. Eine Sicherung ist deine eigene Kopie, unabhängig von Konto und Server.
        }
    </p>
    <div class="setting">
        <span>Letzte Sicherung</span>
        <b>@(Backup.LastBackup is { } last ? German.Relative(last, Today) : "noch nie")</b>
    </div>
    <div class="setting">
        <span>Vor Speichermangel geschützt<small>Entscheidet der Browser</small></span>
        <b>@(storageProtected switch { true => "ja", false => "nein", null => "…" })</b>
    </div>
    <button class="btn primary" @onclick="Backup.ExportAsync"><Icon Name="download" />Sicherung speichern</button>
    <label class="btn">
        <Icon Name="upload" />Sicherung laden
        <InputFile class="visually-hidden" accept=".json,application/json" OnChange="Import" />
    </label>
</div>

@code {
    private const long MaxBackupBytes = 5_000_000;

    private bool? storageProtected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        storageProtected = await Browser.ProtectStorageAsync();
        StateHasChanged();
    }

    private async Task Import(InputFileChangeEventArgs e)
    {
        string json;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxBackupBytes));
            json = await reader.ReadToEndAsync();
        }
        catch (IOException)
        {
            Dialogs.Alert($"Die Datei ließ sich nicht lesen. Ist sie größer als {MaxBackupBytes / 1_000_000} MB?");
            return;
        }

        var result = await Backup.ImportAsync(json, () => Dialogs.Confirm(
            "Alle Daten auf diesem Gerät durch die Sicherung ersetzen?", ok: "Ersetzen", cancel: "Abbrechen", danger: true));
        if (result == ImportResult.NotABackup) Dialogs.Alert($"Das ist keine Sicherung von {AppInfo.Name}.");
        if (result == ImportResult.Restored) Dialogs.Alert("Sicherung geladen.");
    }
}
