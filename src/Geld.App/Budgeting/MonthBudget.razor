@page "/budget"
@inherits DataComponent
@inject BudgetService BudgetService

<TopBar Title="Budget" Kicker="@(Budget.NetSalary > 0 ? $"Netto {Euro.Format(Budget.NetSalary)}" : "Monatsbudget")" />
<Banners />

@* Only the current and later months: past months would be recomputed with today's salary and costs. *@
<div class="month-nav">
    <button class="icon-btn" aria-label="Vorheriger Monat" disabled="@(offset == 0)" @onclick="() => Go(-1)"><Icon Name="chevron-left" /></button>
    <span>@German.Month(Month.Year, Month.Month)</span>
    <button class="icon-btn" aria-label="Nächster Monat" @onclick="() => Go(1)"><Icon Name="chevron-right" /></button>
</div>

<div class="card tappable">
    @if (Budget.NetSalary == 0)
    {
        <div class="row"><b>Nettogehalt eintragen</b><Icon Name="chevron-right" /></div>
        <small>Davon gehen Fixkosten und Geplantes ab; der Rest ist frei verfügbar.</small>
    }
    else
    {
        <div class="label">Frei verfügbar</div>
        @* Red only for what nothing covers: a month the Rücklage covers is planned that way. *@
        <div class="big amount @(overview.Uncovered > 0 ? "negative" : null)">@Euro.Format(overview.Available)</div>
        @* The salary pays the fixed costs first, then the planned spendings, and the Rücklage what is left over. *@
        <div class="split" aria-hidden="true">
            <div class="fixed" style="width: @Percent(FixedPaid)"></div>
            <div class="planned" style="width: @Percent(PlannedPaid)"></div>
            @if (overview.FromReserve > 0)
            {
                <div class="reserve" style="width: @Percent(overview.FromReserve)"></div>
            }
            @if (overview.Uncovered > 0)
            {
                <div class="uncovered" style="width: @Percent(overview.Uncovered)"></div>
            }
        </div>
        <div class="legend">
            <span><i class="fixed"></i>@Euro.Format(overview.FixedTotal) Fixkosten</span>
            <span><i class="planned"></i>@Euro.Format(overview.PlannedTotal) geplant</span>
            @if (overview.FromReserve > 0)
            {
                <span><i class="reserve"></i>@Euro.Format(overview.FromReserve) aus der Rücklage</span>
            }
        </div>
        @if (overview.Uncovered > 0)
        {
            <div class="status uncovered">Nicht gedeckt: @Euro.Format(overview.Uncovered)</div>
        }
        else if (overview.FromReserve > 0)
        {
            <div class="status covered"><Icon Name="pig-money" />Gedeckt aus der Rücklage</div>
        }
    }
    <button class="cover" aria-label="@(Budget.NetSalary == 0 ? "Nettogehalt eintragen" : "Nettogehalt ändern")"
            @onclick="() => Open(Sheet.Salary)"></button>
</div>

<button class="card reserve-card @(overview.ReserveAtStart is null ? "empty" : null)" @onclick="() => Open(Sheet.Reserve)">
    <Icon Name="pig-money" />
    @if (overview.ReserveAtStart is { } reserve)
    {
        <span><b>Rücklage</b><small>@ReserveNote</small></span>
        <span class="reserve-amount">
            <b class="amount">@Euro.Format(reserve)</b>
            @if (overview.FromReserve > 0)
            {
                <small>danach @Euro.Format(overview.ReserveAfter ?? 0)</small>
            }
        </span>
    }
    else
    {
        <span><b>Rücklage eintragen</b><small>Geld neben dem Gehalt, falls ein Monat mehr kostet</small></span>
    }
    <Icon Name="chevron-right" />
</button>

<div class="section">
    <h2>Fixkosten</h2>
    @if (offset == 0 && overview.StillToPay > 0)
    {
        <span class="muted">noch @Euro.Format(overview.StillToPay) offen</span>
    }
    <button class="icon-btn" aria-label="Fixkosten hinzufügen" @onclick="() => Open(Sheet.Deduction)"><Icon Name="plus" /></button>
</div>
<div class="card list">
    @if (overview.Deductions.Count == 0)
    {
        <p class="empty">Miete, Abos, Versicherungen: alles, was regelmäßig abgebucht wird.</p>
    }
    else
    {
        <ul>
            @foreach (var line in overview.Deductions)
            {
                <li>
                    <button class="line @(line.Done ? "done" : null)" @onclick="() => Open(Sheet.Deduction, line.Deduction.Id)">
                        <span class="day">@(line.Date.Day).</span>
                        <span class="name">
                            <b>@line.Deduction.Name</b>
                            @if (line.Deduction.Schedule is EveryWeeks every)
                            {
                                <small>@(every.Weeks == 1 ? "jede Woche" : $"alle {every.Weeks} Wochen")</small>
                            }
                            @if (line == nextDue)
                            {
                                <span class="badge">@German.Relative(line.Date, Today)</span>
                            }
                        </span>
                        <span class="amount">@Euro.Format(line.Deduction.Amount)</span>
                    </button>
                </li>
            }
        </ul>
    }
</div>

<div class="section">
    <h2>Geplant im @German.MonthName(Month.Month)</h2>
    <button class="icon-btn" aria-label="Geplante Ausgabe hinzufügen" @onclick="() => Open(Sheet.Planned)"><Icon Name="plus" /></button>
</div>
<div class="card list">
    @if (overview.Planned.Count == 0)
    {
        <p class="empty">Was du dir diesen Monat noch kaufen willst, z. B. Make-up oder ein Geschenk.</p>
    }
    else
    {
        <ul>
            @foreach (var planned in overview.Planned)
            {
                <li>
                    <button class="line" @onclick="() => Open(Sheet.Planned, planned.Id)">
                        <span class="name"><b>@planned.Name</b></span>
                        <span class="amount">@Euro.Format(planned.Amount)</span>
                    </button>
                </li>
            }
        </ul>
    }
</div>

@switch (sheet)
{
    case Sheet.Salary:
        <AmountSheet Title="Nettogehalt" Label="Netto pro Monat in €" Amount="@(Budget.NetSalary > 0 ? Budget.NetSalary : null)"
                     Accepts="BudgetRules.IsSalary" OnSave="SaveSalary" OnClose="Close" />
        break;
    case Sheet.Reserve:
        <AmountSheet Title="Rücklage" Amount="Budget.Reserve?.Amount" Accepts="BudgetRules.IsReserve" OnSave="SaveReserve"
                     OnDelete="Budget.Reserve is null ? default : EventCallback.Factory.Create(this, RemoveReserve)"
                     DeleteLabel="Rücklage entfernen" OnClose="Close">
            Geld neben dem Gehalt: Tagesgeld, Sparkonto, Übriges aus früheren Monaten. Kostet ein Monat mehr als das
            Gehalt, wird es daraus gedeckt.<br />
            Stand: heute. Trag den Betrag neu ein, wenn du auf dein Konto schaust.
        </AmountSheet>
        break;
    case Sheet.Deduction:
        var deduction = Budget.Deductions.FirstOrDefault(d => d.Id == editId);
        <BudgetItemSheet Title="@(deduction is null ? "Fixkosten" : "Fixkosten bearbeiten")" NamePlaceholder="Miete"
                         Name="@(deduction?.Name ?? "")" Amount="deduction?.Amount" Schedule="@(deduction?.Schedule ?? new MonthlyOn(1))" Today="Today"
                         OnSave="SaveDeduction" OnDelete="deduction is null ? default : EventCallback.Factory.Create(this, DeleteDeduction)"
                         OnClose="Close" />
        break;
    case Sheet.Planned:
        var planned = Budget.Planned.FirstOrDefault(p => p.Id == editId);
        <BudgetItemSheet Title="@(planned is null ? $"Geplant im {German.MonthName(Month.Month)}" : "Geplantes bearbeiten")" NamePlaceholder="Make-up"
                         Name="@(planned?.Name ?? "")" Amount="planned?.Amount" Today="Today"
                         OnSave="SavePlanned" OnDelete="planned is null ? default : EventCallback.Factory.Create(this, DeletePlanned)"
                         OnClose="Close" />
        break;
}

@code {
    private enum Sheet { None, Salary, Reserve, Deduction, Planned }

    private int offset; // months after the current one
    private Sheet sheet;
    private Guid? editId;

    private IReadOnlyBudget Budget => BudgetService.Budget;
    private DateOnly Month => new DateOnly(Today.Year, Today.Month, 1).AddMonths(offset);
    private MonthOverview overview = null!;
    private DeductionLine? nextDue;

    protected override void OnInitialized() => Refresh();

    protected override void OnDataChanged() => Refresh();

    private void Go(int months)
    {
        offset += months;
        Refresh();
    }

    private void Refresh()
    {
        overview = Budget.Overview(Month.Year, Month.Month, Today);
        nextDue = offset == 0 ? overview.Deductions.FirstOrDefault(d => !d.Done) : null;
    }

    private decimal FixedPaid => Math.Min(overview.FixedTotal, overview.Salary);
    private decimal PlannedPaid => Math.Min(overview.PlannedTotal, overview.Salary - FixedPaid);

    /// <summary>"Stand 14.10." in the month it was entered, later months what is left when they start.</summary>
    private string ReserveNote => Budget.Reserve is { AsOf: var asOf } && asOf.Year == Month.Year && asOf.Month == Month.Month
        ? $"Stand {German.DayMonthNumbers(asOf)}"
        : $"Anfang {German.MonthName(Month.Month)}";

    /// <summary>Share of the salary, for the bar; the bar is the salary or, when more is taken, everything taken.</summary>
    private string Percent(decimal amount) => Css.Percent(amount, Math.Max(overview.Salary, overview.FixedTotal + overview.PlannedTotal));

    private void Open(Sheet kind, Guid? id = null) => (sheet, editId) = (kind, id);

    private void Close() => (sheet, editId) = (Sheet.None, null);

    private void Saved() => Close();

    private void SaveSalary(decimal salary)
    {
        BudgetService.SetSalary(salary);
        Saved();
    }

    private void SaveReserve(decimal amount)
    {
        BudgetService.SetReserve(amount);
        Saved();
    }

    private void RemoveReserve()
    {
        BudgetService.RemoveReserve();
        Saved();
    }

    private void SaveDeduction(BudgetItemSheet.Result r)
    {
        BudgetService.SaveDeduction(editId, r.Name, r.Amount, r.Schedule!);
        Saved();
    }

    private void DeleteDeduction()
    {
        BudgetService.RemoveDeduction(editId!.Value);
        Saved();
    }

    private void SavePlanned(BudgetItemSheet.Result r)
    {
        BudgetService.SavePlanned(editId, Month.Year, Month.Month, r.Name, r.Amount);
        Saved();
    }

    private void DeletePlanned()
    {
        BudgetService.RemovePlanned(editId!.Value);
        Saved();
    }
}
