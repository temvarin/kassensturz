@using Geld.App.Sync
@inherits LayoutComponentBase
@inject Browser Browser
@inject SyncService Sync
@inject AppState State

<header class="topbar">
    <SectionOutlet SectionName="@TopBar.Section" />
</header>
<main>
    @Body
</main>
<TabBar />
<DialogHost />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ = Browser.ProtectStorageAsync(); // the browser answers in its own time, and nothing waits for it
        await Browser.WhenVisibleAsync(async () =>
        {
            State.Refresh();
            await Sync.ResumeAsync();
        });
        await Sync.StartAsync();
    }
}
