@* Only for a phone that has synced before. One that never did uses the app without an account, which is fine. *@
@implements IDisposable
@inject SyncService Sync
@inject AccountService Account
@inject NavigationManager Navigation

@if (Account.Status == AccountStatus.SignedOut && Sync.LastSync is not null)
{
    <button class="banner" @onclick="SignIn">
        <Icon Name="cloud-off" />
        <span>Abgemeldet – Änderungen werden nicht synchronisiert. Anmelden</span>
        <Icon Name="chevron-right" />
    </button>
}

@code {
    protected override void OnInitialized() => Sync.Changed += OnChanged;

    public void Dispose() => Sync.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    // Easy Auth's page, not the app's, so a full page load is needed.
    private void SignIn() => Navigation.NavigateTo(
        $"/.auth/login/aad?post_login_redirect_uri=/{Navigation.ToBaseRelativePath(Navigation.Uri)}", forceLoad: true);
}
